# Copy to .env.local (git-ignored) for local builds. On Vercel set these in Project → Settings →
# Environment Variables; on Netlify in the site's environment variables (SITE_URL and
# VITE_DEMO_MODE are already in netlify.toml). See DEPLOY.md.

# WhatsApp number for the lead form's "Dërgo edhe në WhatsApp" hand-off and the WhatsApp links,
# e.g. +383 44 123 456. Empty: every WhatsApp action is hidden. WHATSAPP_NUMBER in
# src/config/contact.ts takes precedence.
VITE_WHATSAPP_NUMBER=

# Demo mode: noindex meta + X-Robots-Tag + disallow-all robots.txt. On unless exactly "false".
VITE_DEMO_MODE=true


# SITE_URL (canonical, Open Graph, JSON-LD base URL) is a build environment variable, not a .env
# value: it is set in netlify.toml, and on Vercel it falls back to the project's production domain;
# locally run e.g. SITE_URL=https://pozhegu.elevateurbox.com npm run build
