# Copy to .env.local (git-ignored) for local builds. On Vercel set these in Project → Settings →
# Environment Variables. See DEPLOY.md.

# WhatsApp number for the lead form's "Dërgo edhe në WhatsApp" hand-off and the WhatsApp links,
# e.g. +383 44 123 456. Empty (the default): every WhatsApp action is hidden.
VITE_WHATSAPP_NUMBER=

# Demo mode: noindex meta + X-Robots-Tag + disallow-all robots.txt. On unless exactly "false".
# The portfolio demo always keeps it on.
VITE_DEMO_MODE=true


# SITE_URL (canonical link and Open Graph base URL) is a build environment variable, not a .env
# value. The demo uses SITE_URL=https://demo.elevateurbox.com, set in Vercel's environment variables;
# without it Vercel builds fall back to the project's production domain. Locally run e.g.
#   SITE_URL=https://demo.elevateurbox.com npm run build
